---
import type { Member } from "../types";
import { site } from "../data/site";

interface Props {
  member: Member;
}

const { member } = Astro.props;

const pageUrl = Astro.url.href;
---

<div class="min-h-screen bg-base-200 px-4 py-8 sm:px-6">
  <main class="mx-auto flex max-w-md flex-col items-center gap-6">
    <!-- Business card -->
    <article
      class="card w-full overflow-hidden border border-base-300 bg-base-100 shadow-xl"
    >
      <!-- Header -->
      <div class="bg-primary px-6 pb-8 pt-10 text-primary-content">
        <div class="flex justify-center">
          {
            member.image ? (
              <div class="avatar">
                <div class="w-28 rounded-full ring-4 ring-primary-content/20 ring-offset-4 ring-offset-primary">
                  <img src={member.image} alt={member.name} />
                </div>
              </div>
            ) : (
              <div class="avatar placeholder">
                <div class="w-28 rounded-full bg-primary-content/10 text-primary-content ring-4 ring-primary-content/20 ring-offset-4 ring-offset-primary">
                  <span class="text-3xl font-medium">
                    {member.name
                      .split(" ")
                      .map((part) => part[0])
                      .join("")
                      .slice(0, 2)
                      .toUpperCase()}
                  </span>
                </div>
              </div>
            )
          }
        </div>

        <div class="mt-6 text-center">
          <h1 class="text-2xl font-semibold tracking-tight">
            {member.name}
          </h1>

          {
            member.title && (
              <p class="mt-1 text-sm text-primary-content/80">{member.title}</p>
            )
          }
        </div>
      </div>

      <!-- Content -->
      <div class="card-body gap-6">
        <div class="flex flex-col gap-3">
          {
            member.email && (
              <a
                href={`mailto:${member.email}`}
                class="btn btn-outline btn-block justify-start"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"
                  />
                </svg>
                Email
              </a>
            )
          }

          {
            member.phone && (
              <a
                href={`tel:${member.phone}`}
                class="btn btn-outline btn-block justify-start"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.5 4.5A2 2 0 014.7 2.7l2.1-.5a2 2 0 012.3 1.1l1.1 2.7a2 2 0 01-.5 2.2L8.4 9.8a16 16 0 005.8 5.8l1.6-1.3a2 2 0 012.2-.5l2.7 1.1a2 2 0 011.1 2.3l-.5 2.1a2 2 0 01-1.8 2.2C10.7 21.5 2.5 13.3 2.5 4.5z"
                  />
                </svg>
                Chiama
              </a>
            )
          }

          {
            member.website && (
              <a
                href={member.website}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline btn-block justify-start"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.2-2.5 3.5-5.7 3.5-9S14.2 5.5 12 3m0 18c-2.2-2.5-3.5-5.7-3.5-9S9.8 5.5 12 3M3.5 12h17"
                  />
                </svg>
                Sito web
              </a>
            )
          }

          {
            member.linkedin && (
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline btn-block justify-start"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  />
                </svg>
                LinkedIn
              </a>
            )
          }

          {
            member.instagram && (
              <a
                href={member.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline btn-block justify-start"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                  />
                </svg>
                Instagram
              </a>
            )
          }

          {
            member.facebook && (
              <a
                href={member.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline btn-block justify-start"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  />
                </svg>
                Facebook
              </a>
            )
          }
        </div>
      </div>
      {
        (member.email || member.phone) && (
          <button
            type="button"
            id="add-to-contacts"
            class="btn btn-primary btn-block justify-center"
            data-member={JSON.stringify({
              name: member.name,
              email: member.email ?? "",
              phone: member.phone ?? "",
              website: member.website ?? "",
              linkedin: member.linkedin ?? "",
              instagram: member.instagram ?? "",
              facebook: member.facebook ?? "",
            })}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19a6 6 0 00-12 0M9 13a4 4 0 100-8 4 4 0 000 8zM19 8v6M22 11h-6"
              />
            </svg>
            Aggiungi alla rubrica
          </button>
        )
      }

      <!-- Footer -->
      <div class="border-t border-base-300 px-6 py-4 text-center">
        <p class="text-xs text-base-content/50">
          <!-- Logo -->
          <div class="flex justify-center">
            <a href="/" aria-label="Comfortzone">
              <img
                src={site.logo}
                alt={`${site.name} logo`}
                class="h-32 w-auto"
              />
            </a>
          </div>

          <!-- Social links -->
          <div class="mt-5 flex items-center justify-center gap-3">
            <a
              href={site.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram Comfortzone"
              class="btn btn-circle btn-ghost"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                ></path>
              </svg>
            </a>

            <a
              href={site.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook Comfortzone"
              class="btn btn-circle btn-ghost"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path>
              </svg>
            </a>

            <a
              href="https://www.comfortzonecoworking.com/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Sito web Comfortzone"
              class="btn btn-circle btn-ghost"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.2-2.5 3.5-5.7 3.5-9S14.2 5.5 12 3m0 18c-2.2-2.5-3.5-5.7-3.5-9S9.8 5.5 12 3M3.5 12h17"
                ></path>
              </svg>
            </a>
          </div>
        </p>
      </div>
    </article>
  </main>
</div>

<script>
  const contactButton =
    document.querySelector<HTMLButtonElement>("#add-to-contacts");

  contactButton?.addEventListener("click", () => {
    const member = JSON.parse(contactButton.dataset.member ?? "{}");

    const escapeVCard = (value: string) =>
      value
        .replace(/\\/g, "\\\\")
        .replace(/\n/g, "\\n")
        .replace(/;/g, "\\;")
        .replace(/,/g, "\\,");

    const nameParts = member.name.trim().split(/\s+/);
    const firstName = nameParts.shift() ?? "";
    const lastName = nameParts.join(" ");

    const lines = [
      "BEGIN:VCARD",
      "VERSION:3.0",
      `N:${escapeVCard(lastName)};${escapeVCard(firstName)};;;`,
      `FN:${escapeVCard(member.name)}`,
    ];

    if (member.role) {
      lines.push(`TITLE:${escapeVCard(member.role)}`);
    }

    if (member.company) {
      lines.push(`ORG:${escapeVCard(member.company)}`);
    }

    if (member.phone) {
      lines.push(`TEL;TYPE=CELL:${escapeVCard(member.phone)}`);
    }

    if (member.email) {
      lines.push(`EMAIL;TYPE=INTERNET:${escapeVCard(member.email)}`);
    }

    if (member.website) {
      lines.push(`URL:${escapeVCard(member.website)}`);
    }

    if (member.linkedin) {
      lines.push(
        `X-SOCIALPROFILE;TYPE=linkedin:${escapeVCard(member.linkedin)}`,
      );
    }

    if (member.instagram) {
      lines.push(
        `X-SOCIALPROFILE;TYPE=instagram:${escapeVCard(member.instagram)}`,
      );
    }

    if (member.facebook) {
      lines.push(
        `X-SOCIALPROFILE;TYPE=facebook:${escapeVCard(member.facebook)}`,
      );
    }

    lines.push("END:VCARD");

    const vcard = lines.join("\r\n");

    const blob = new Blob([vcard], {
      type: "text/vcard;charset=utf-8",
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    const filename = member.name
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/gi, "-")
      .replace(/^-|-$/g, "");

    link.href = url;
    link.download = `${filename}.vcf`;

    document.body.appendChild(link);
    link.click();
    link.remove();

    URL.revokeObjectURL(url);
  });
</script>
